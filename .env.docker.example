HTTP_PORT=8080

POSTGRES_DB=gravedb
POSTGRES_USER=grave
POSTGRES_PASSWORD=grave

# Development login for /admin/statistik. Use a strong password outside development.
ANALYTICS_ADMIN_USER=admin
ANALYTICS_ADMIN_PASSWORD=change-me-dev

# Platform mails are sent through the internal docker-mailserver.
# Port 25 is used inside the Docker network; no host mail ports are published in development.
SMTP_HOST=mailserver
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@friedhof.test
SMTP_SECURE=false

MAILSERVER_CONTAINER_NAME=friedhof-mailserver-dev
MAILSERVER_HOSTNAME=mail.friedhof.test
MAILSERVER_DOMAINNAME=friedhof.test
MAILSERVER_ENABLE_SPAMASSASSIN=0
MAILSERVER_ENABLE_CLAMAV=0
MAILSERVER_ENABLE_FAIL2BAN=0
MAILSERVER_PERMIT_DOCKER=network
MAILSERVER_SSL_TYPE=

WEBMAIL_CONTAINER_NAME=friedhof-webmail-dev
WEBMAIL_PORT=8081

GRAVE_DB_CONTEXT=./submodules/grave-db
GRAVE_DB_DOCKERFILE=Dockerfile
GRAVE_DB_IMPORTER_DOCKERFILE=Dockerfile.importer

# Path to the Angular cemetery-tour submodule from this repository.
CEMETERY_TOUR_CONTEXT=./submodules/cemetery-tour
CEMETERY_TOUR_DOCKERFILE=Dockerfile

# Angular should be built for /tour/ so browser asset URLs stay under that path.
CEMETERY_TOUR_BUILD_COMMAND=npm run build -- --base-href /tour/ --deploy-url /tour/

# Set this to the Angular output folder that contains index.html.
CEMETERY_TOUR_DIST_DIR=www
