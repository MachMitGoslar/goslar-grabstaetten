HTTP_PORT=8080

POSTGRES_DB=gravedb
POSTGRES_USER=grave
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_HOST=db

# Optional override for external databases or Plesk setups where the DB is not in the same Compose network.
# DATABASE_URL=postgresql://grave:grave@db:5432/gravedb

# Image prefix used by docker-compose.production.yml.
GHCR_IMAGE_PREFIX=ghcr.io/machmitgoslar/goslar-grabstaetten

# Use latest for default-branch deployments, main for branch tag, sha-<commit> for immutable deployments, or a v* tag.
IMAGE_TAG=latest

ANALYTICS_ADMIN_USER=admin
ANALYTICS_ADMIN_PASSWORD=CHANGE_ME_STRONG_BOOTSTRAP_ADMIN_PASSWORD
PUBLIC_BASE_URL=https://friedhof.goslar.de
FORCE_SECURE_COOKIES=true

# Mailserver / SMTP for admin setup and password reset mails.
SMTP_HOST=mailserver
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@friedhof.goslar.de
SMTP_SECURE=false

MAILSERVER_CONTAINER_NAME=friedhof-mailserver
MAILSERVER_HOSTNAME=mail.friedhof.goslar.de
MAILSERVER_DOMAINNAME=friedhof.goslar.de
MAILSERVER_SMTP_PORT=25
MAILSERVER_SUBMISSION_PORT=587
MAILSERVER_IMAPS_PORT=993
MAILSERVER_ENABLE_SPAMASSASSIN=0
MAILSERVER_ENABLE_CLAMAV=0
MAILSERVER_ENABLE_FAIL2BAN=1
MAILSERVER_PERMIT_DOCKER=network
MAILSERVER_SSL_TYPE=letsencrypt
LETSENCRYPT_PATH=/etc/letsencrypt
